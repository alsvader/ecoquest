{
  "name": "ecoquest-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "photos": "node scripts/copy-photos.mjs",
    "capture": "node scripts/capture.mjs",
    "music": "node scripts/make-music.mjs",
    "stills": "node scripts/stills.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts EcoQuestPromo out/ecoquest-promo.mp4 --codec=h264 --crf=16",
    "still": "remotion still src/index.ts EcoQuestPromo out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19",
    "playwright": "1.64.0",
    "typescript": "^5"
  }
}
